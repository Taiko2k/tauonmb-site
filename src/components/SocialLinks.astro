---
import config from 'virtual:starlight/user-config';

const social = config.social || [];
const links = [
	{ label: 'Docs', href: '/manual/overview/' },
	{ label: 'Download', href: '/manual/installing/', class: 'wide-only' },
	...social.map(({ label, href }) => ({ label, href, rel: 'me' })),
];
---

<nav class="tauon-nav sl-flex" aria-label="Site">
	{links.map(({ label, href, rel, class: cls }) => <a {href} {rel} class={cls}>{label}</a>)}
</nav>

<style>
	.tauon-nav {
		gap: 2rem;
		align-items: center;
	}
	.tauon-nav a {
		font-family: var(--sl-font);
		font-size: 0.9375rem;
		font-weight: 300;
		color: var(--sl-color-gray-3);
		text-decoration: none;
	}
	.tauon-nav a:hover {
		color: var(--sl-color-white);
	}
	@media (max-width: 40rem) {
		.tauon-nav {
			gap: 1.1rem;
		}
		.tauon-nav a {
			font-size: 0.875rem;
		}
	}
</style>
