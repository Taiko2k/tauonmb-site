---
import { Code, Icon } from '@astrojs/starlight/components';

/* Downloads list for the installing page.
   The version number and release date are fetched from GitHub at build time
   and baked into the static page; download links use the stable
   `releases/latest/download/` URLs so they never go stale between builds. */

let version = 'latest';
let released = '';
try {
	const res = await fetch('https://api.github.com/repos/Taiko2k/Tauon/releases/latest');
	if (res.ok) {
		const data = await res.json();
		if (data.tag_name) version = data.tag_name;
		if (data.published_at)
			released = new Date(data.published_at).toLocaleDateString('en-NZ', {
				month: 'long',
				year: 'numeric',
			});
	}
} catch {
	/* Offline or rate-limited build — fall back to "latest" with no date. */
}

const latest = 'https://github.com/Taiko2k/Tauon/releases/latest/download/';

const rows = [
	{
		os: 'windows',
		name: 'Windows',
		icon: 'seti:windows',
		desc: 'Installer for 64-bit Windows 10 and later.',
		action: 'Download installer',
		href: `${latest}TauonMusicBox-windows-installer.exe`,
		extra: [{ label: 'Portable .7z', href: `${latest}TauonMusicBox-windows.7z` }],
	},
	{
		os: 'mac',
		name: 'macOS',
		icon: 'apple',
		desc: 'Signed disk image. Open it and drag Tauon to Applications.',
		action: 'Download .dmg',
		href: `${latest}Tauon-signed.dmg`,
	},
	{
		os: 'linux',
		name: 'Linux',
		icon: 'linux',
		desc: 'Flatpak for most distributions. Install it from Flathub, or run:',
		command: 'flatpak install flathub com.github.taiko2k.tauonmb',
		action: 'Get it on Flathub',
		href: 'https://flathub.org/apps/com.github.taiko2k.tauonmb',
	},
	{
		os: 'arch',
		name: 'Arch Linux',
		icon: 'linux',
		desc: 'In the official extra repository:',
		command: 'sudo pacman -S tauon-music-box',
		action: 'View package',
		href: 'https://archlinux.org/packages/extra/x86_64/tauon-music-box/',
	},
] as const;
---

<div class="dl not-content">
	<p class="dl-release">
		<span>Latest</span>
		<span class="dl-version">{version}</span>
		{released && <span>· {released}</span>}
		<span>·</span>
		<a href="https://github.com/Taiko2k/Tauon/releases/latest">Release notes →</a>
	</p>

	<div class="dl-rows">
		{
			rows.map((r) => (
				<section class="dl-row" data-os={r.os} aria-labelledby={`dl-${r.os}`}>
					<h3 class="dl-name" id={`dl-${r.os}`}>
						<Icon name={r.icon} class="dl-icon" size="1.125rem" />
						{r.name}
						<span class="dl-yours">Your system</span>
					</h3>
					<div class="dl-body">
						<p class="dl-desc">{r.desc}</p>
						{'command' in r && <Code code={r.command} lang="sh" frame="none" />}
						<div class="dl-actions">
							<a class="dl-button" href={r.href}>
								{r.action}
							</a>
							{'extra' in r &&
								r.extra.map((e) => (
									<a class="dl-link" href={e.href}>
										{e.label}
									</a>
								))}
						</div>
					</div>
				</section>
			))
		}
	</div>
</div>

<script>
	// Put the visitor's platform first and highlight its download.
	const ua = navigator.userAgent;
	const touch = navigator.maxTouchPoints > 1;
	let os: string | null = null;
	if (/Windows/.test(ua)) os = 'windows';
	else if (/Macintosh/.test(ua) && !touch) os = 'mac';
	else if (/Linux|X11/.test(ua) && !/Android/.test(ua)) os = 'linux';

	const row = os && document.querySelector<HTMLElement>(`.dl-row[data-os="${os}"]`);
	if (row) {
		row.classList.add('is-yours');
		row.parentElement?.prepend(row);
	}
</script>

<style>
	.dl {
		margin-top: 1.5rem;
	}

	.dl-release {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: 0.5rem;
		margin: 0 0 2rem;
		font-family: var(--sl-font-mono);
		font-size: 0.75rem;
		font-weight: 300;
		letter-spacing: 0.04em;
		color: #7a7a7e;
	}
	.dl-version {
		color: #e6e6e6;
	}
	.dl-release a {
		color: #b8b8bc;
		text-decoration: none;
		border-bottom: 1px solid #4a4a4e;
	}
	.dl-release a:hover {
		color: #ffffff;
		border-bottom-color: #9a9a9e;
	}

	.dl-row {
		display: grid;
		grid-template-columns: 10rem minmax(0, 1fr);
		gap: 0.75rem 2rem;
		padding: 2rem 0;
		border-top: 1px solid #1c1c1e;
	}
	.dl-row:last-child {
		border-bottom: 1px solid #1c1c1e;
	}
	@media (max-width: 40rem) {
		.dl-row {
			grid-template-columns: minmax(0, 1fr);
			padding: 1.5rem 0;
		}
	}

	.dl-name {
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		align-content: start;
		gap: 0.625rem;
		font-family: var(--sl-font);
		font-size: 1.25rem;
		font-weight: 300;
		line-height: 1.3;
		color: #f2f2f2;
	}
	.dl-name :global(.dl-icon) {
		color: #9a9a9e;
	}
	.dl-yours {
		display: none;
		flex-basis: 100%;
		font-family: var(--sl-font-mono);
		font-size: 0.625rem;
		font-weight: 300;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: #9a9a9e;
	}
	.is-yours .dl-yours {
		display: block;
	}
	.is-yours .dl-name :global(.dl-icon) {
		color: #f2f2f2;
	}

	.dl-desc {
		margin: 0 0 1rem;
		font-size: 1rem;
		font-weight: 300;
		line-height: 1.6;
		color: #b8b8bc;
	}
	.dl-body :global(.expressive-code) {
		margin: 0 0 1.25rem;
	}

	.dl-actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.75rem 1.5rem;
	}
	.dl-button {
		display: inline-block;
		padding: 0.625rem 1.125rem;
		border: 1px solid #4a4a4e;
		border-radius: 6px;
		font-size: 0.9375rem;
		font-weight: 400;
		color: #e6e6e6;
		text-decoration: none;
	}
	.dl-button:hover {
		border-color: #9a9a9e;
		color: #ffffff;
	}
	.is-yours .dl-button {
		background: #e6e6e6;
		border-color: #e6e6e6;
		color: #0d0d0e;
		font-weight: 500;
	}
	.is-yours .dl-button:hover {
		background: #ffffff;
		border-color: #ffffff;
		color: #0d0d0e;
	}
	.dl-link {
		font-size: 0.9375rem;
		font-weight: 300;
		color: #b8b8bc;
		text-decoration: none;
		border-bottom: 1px solid #4a4a4e;
		padding-bottom: 2px;
	}
	.dl-link:hover {
		color: #ffffff;
		border-bottom-color: #9a9a9e;
	}
</style>
